# Phone Agent API v2.0 - Environment Variables

# API Configuration
ENVIRONMENT=production

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Qdrant Configuration (Vector Database for Knowledge Base)
QDRANT_URL=http://qdrant-agents:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=company_knowledge

# Redis Configuration (Session Management)
REDIS_URL=redis://redis-agents:6379
REDIS_PASSWORD=

# HubSpot Configuration (Optional)
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Google Sheets Configuration (Optional)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=/app/service-account.json

# Gmail Configuration (Optional - for notifications)
SENDER_EMAIL=your_email@company.com
NOTIFICATION_EMAIL=alerts@company.com

# Twilio WhatsApp (Optional - for alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+41791234567

# Brand Settings
BRAND_NAME=Your Company
COMPANY_DESCRIPTION=AI-powered business solutions
